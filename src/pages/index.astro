---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = `${import.meta.env.BASE_URL}/`;

const heroImage = `${base}images/home/hero.jpg`;
const japanImage = `${base}images/japan/cover.jpg`;
const omanImage = `${base}images/oman/cover.jpg`;

const japanPhoto = `${base}images/japan/tokyo-autumn-leaf.jpg`;
const fujiPhoto = `${base}images/japan/mt-fuji-forest-road.jpg`;
const familyPhoto = `${base}images/japan/teamlab-family.jpg`;
---

<BaseLayout
  title="Travel With Masala Chai | Travel Stories & Experiences"
  description="Travel stories, family journeys, photographs and practical travel guides from Travel With Masala Chai."
>

  <!-- HERO -->
  <section class="hero">

    <div
      class="hero-image"
      style={`background-image: url('${heroImage}')`}
    ></div>

    <div class="hero-overlay"></div>

    <div class="hero-content">

      <p class="hero-kicker">
        TRAVEL WITH MASALA CHAI
      </p>

      <h1>
        Journeys worth
        <em> remembering.</em>
      </h1>

      <p class="hero-description">
        Family adventures, beautiful places and honest travel stories —
        with the practical details that make planning your own journey easier.
      </p>

      <div class="hero-actions">
        <a href={`${base}journal/`} class="hero-button">
          Explore our journeys
          <span>→</span>
        </a>

        <a href="#featured" class="hero-secondary">
          Discover more
          <span>↓</span>
        </a>
      </div>

    </div>

    <div class="hero-scroll">
      SCROLL TO EXPLORE
      <span></span>
    </div>

  </section>


  <!-- INTRO -->
  <section class="intro">

    <div class="intro-label">
      <span>01</span>
      <span>THE JOURNEY</span>
    </div>

    <div class="intro-content">

      <p class="intro-small">
        Welcome to Travel With Masala Chai
      </p>

      <h2>
        Travel stories from
        <em> our side of the world.</em>
      </h2>

      <p>
        From wandering through Japanese cities and mountains to discovering
        the quiet edges of the Arabian desert, this is a collection of
        journeys, photographs and things we've learned along the way.
      </p>

      <a href={`${base}about/`} class="text-link">
        More about the journey <span>→</span>
      </a>

    </div>

  </section>


  <!-- FEATURED JOURNEYS -->
  <section class="featured" id="featured">

    <div class="section-top">

      <div>
        <p class="eyebrow">FEATURED JOURNEYS</p>
        <h2>Where we've been</h2>
      </div>

      <a href={`${base}journal/`} class="view-link">
        View all journeys <span>→</span>
      </a>

    </div>


    <div class="journey-grid">

      <!-- JAPAN -->
      <a
        href={`${base}journal/japan/`}
        class="journey-card journey-large"
      >

        <div
          class="journey-image"
          style={`background-image: url('${japanImage}')`}
        ></div>

        <div class="journey-overlay"></div>

        <div class="journey-info">

          <span class="journey-number">01</span>

          <div>
            <p>ASIA · FAMILY JOURNEY</p>
            <h3>Japan</h3>
            <span class="journey-arrow">Explore journey →</span>
          </div>

        </div>

      </a>


      <!-- OMAN -->
      <a
        href={`${base}journal/`}
        class="journey-card"
      >

        <div
          class="journey-image"
          style={`background-image: url('${omanImage}')`}
        ></div>

        <div class="journey-overlay"></div>

        <div class="journey-info">

          <span class="journey-number">02</span>

          <div>
            <p>MIDDLE EAST · DESERT JOURNEY</p>
            <h3>Oman</h3>
            <span class="journey-arrow">Explore journey →</span>
          </div>

        </div>

      </a>


      <!-- SOUTH KOREA -->
      <a
        href={`${base}journal/`}
        class="journey-card"
      >

        <div
          class="journey-image korea-image"
        ></div>

        <div class="journey-overlay"></div>

        <div class="journey-info">

          <span class="journey-number">03</span>

          <div>
            <p>ASIA · AUTUMN JOURNEY</p>
            <h3>South Korea</h3>
            <span class="journey-arrow">Coming soon →</span>
          </div>

        </div>

      </a>

    </div>

  </section>


  <!-- FEATURED STORY -->
  <section class="story-feature">

    <div class="story-image-wrap">

      <img
        src={japanPhoto}
        alt="Autumn colours in Japan"
      />

    </div>

    <div class="story-content">

      <p class="eyebrow">FROM THE JOURNAL</p>

      <p class="story-category">
        JAPAN · FAMILY TRAVEL
      </p>

      <h2>
        Japan through
        <em>our eyes.</em>
      </h2>

      <p>
        Tokyo, Mt. Fuji and Hokkaido — an 11-day family journey through
        cities, mountains, autumn colours and some unforgettable moments.
      </p>

      <a
        href={`${base}journal/japan/`}
        class="dark-button"
      >
        Read the Japan story
        <span>→</span>
      </a>

    </div>

  </section>


  <!-- PHOTO STRIP -->
  <section class="photo-strip">

    <div
      class="strip-photo"
      style={`background-image: url('${familyPhoto}')`}
    ></div>

    <div
      class="strip-photo"
      style={`background-image: url('${fujiPhoto}')`}
    ></div>

    <div
      class="strip-photo"
      style={`background-image: url('${japanPhoto}')`}
    ></div>

  </section>


  <!-- EXPLORE -->
  <section class="explore">

    <div class="explore-heading">

      <p class="eyebrow">EXPLORE</p>

      <h2>
        Find your next
        <em>inspiration.</em>
      </h2>

    </div>


    <div class="explore-grid">

      <a href={`${base}journal/`} class="explore-card">
        <span class="explore-icon">✦</span>
        <h3>Journeys</h3>
        <p>
          Personal travel stories, photographs and experiences from the road.
        </p>
        <span class="explore-arrow">Explore journeys →</span>
      </a>

      <a href={`${base}blog/`} class="explore-card">
        <span class="explore-icon">↗</span>
        <h3>Travel Guides</h3>
        <p>
          Practical ideas, itineraries and useful details for planning your trip.
        </p>
        <span class="explore-arrow">Read the guides →</span>
      </a>

      <a href={`${base}about/`} class="explore-card">
        <span class="explore-icon">☕</span>
        <h3>Our Story</h3>
        <p>
          Why Travel With Masala Chai exists and the journeys behind it.
        </p>
        <span class="explore-arrow">Meet us →</span>
      </a>

    </div>

  </section>


  <!-- CLOSING CTA -->
  <section class="closing">

    <div class="closing-inner">

      <p class="eyebrow">TRAVEL · STORIES · EXPERIENCES</p>

      <h2>
        There is always
        <em> another journey.</em>
      </h2>

      <a href={`${base}journal/`} class="light-button">
        Start exploring
        <span>→</span>
      </a>

    </div>

  </section>

</BaseLayout>


<style>

  /* =========================
     GLOBAL
  ========================= */

  .hero,
  .intro,
  .featured,
  .story-feature,
  .explore,
  .closing {
    width: 100%;
  }

  .eyebrow {
    margin: 0 0 14px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 3px;
    color: #8b4a3c;
  }


  /* =========================
     HERO
  ========================= */

  .hero {
    position: relative;
    min-height: 760px;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: white;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    transform: scale(1.01);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(8, 20, 30, 0.78) 0%,
        rgba(8, 20, 30, 0.48) 43%,
        rgba(8, 20, 30, 0.08) 100%
      );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1400px;
    margin: auto;
    padding: 120px 7%;
  }

  .hero-kicker {
    margin: 0 0 25px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 4px;
  }

  .hero h1 {
    max-width: 780px;
    margin: 0;
    font-family:
      Georgia,
      "Times New Roman",
      serif;
    font-size: clamp(58px, 7vw, 105px);
    line-height: 0.95;
    font-weight: 400;
    letter-spacing: -4px;
  }

  .hero h1 em,
  .intro h2 em,
  .story-content h2 em,
  .explore-heading h2 em,
  .closing h2 em {
    font-weight: 400;
    font-style: italic;
  }

  .hero-description {
    max-width: 560px;
    margin: 30px 0 35px;
    font-size: 18px;
    line-height: 1.7;
    color: rgba(255,255,255,0.9);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 25px;
  }

  .hero-button,
  .dark-button,
  .light-button {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 16px 24px;
    text-decoration: none;
    font-weight: 600;
    transition: 0.25s ease;
  }

  .hero-button {
    background: white;
    color: #172536;
  }

  .hero-button:hover,
  .dark-button:hover,
  .light-button:hover {
    transform: translateY(-3px);
  }

  .hero-secondary {
    color: white;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }

  .hero-secondary span {
    margin-left: 8px;
  }

  .hero-scroll {
    position: absolute;
    z-index: 3;
    right: 6%;
    bottom: 35px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 9px;
    letter-spacing: 2px;
    opacity: 0.8;
  }

  .hero-scroll span {
    display: block;
    width: 45px;
    height: 1px;
    background: white;
  }


  /* =========================
     INTRO
  ========================= */

  .intro {
    display: grid;
    grid-template-columns: 22% 1fr;
    max-width: 1200px;
    margin: auto;
    padding: 120px 6%;
  }

  .intro-label {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 7px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #8b4a3c;
  }

  .intro-label span:first-child {
    color: #a9a49c;
  }

  .intro-content {
    max-width: 780px;
  }

  .intro-small {
    margin: 0 0 15px;
    color: #8b4a3c;
    font-size: 14px;
    font-weight: 600;
  }

  .intro h2 {
    margin: 0 0 25px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(42px, 5vw, 68px);
    line-height: 1.02;
    font-weight: 400;
    letter-spacing: -2px;
    color: #172536;
  }

  .intro-content > p:not(.intro-small) {
    max-width: 670px;
    margin: 0 0 25px;
    color: #59636c;
    font-size: 18px;
    line-height: 1.75;
  }

  .text-link {
    color: #172536;
    text-decoration: none;
    font-weight: 700;
    border-bottom: 1px solid #8b4a3c;
    padding-bottom: 5px;
  }

  .text-link span {
    margin-left: 7px;
  }


  /* =========================
     FEATURED JOURNEYS
  ========================= */

  .featured {
    padding: 110px 6% 120px;
    background: #f3f0e9;
  }

  .section-top {
    max-width: 1250px;
    margin: 0 auto 45px;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .section-top h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(42px, 5vw, 68px);
    line-height: 1;
    font-weight: 400;
    color: #172536;
    letter-spacing: -2px;
  }

  .view-link {
    color: #172536;
    text-decoration: none;
    font-weight: 600;
    margin-bottom: 5px;
  }

  .view-link span {
    margin-left: 7px;
  }

  .journey-grid {
    max-width: 1250px;
    margin: auto;
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    grid-template-rows: 300px 300px;
    gap: 18px;
  }

  .journey-card {
    position: relative;
    overflow: hidden;
    min-height: 300px;
    color: white;
    text-decoration: none;
    background: #172536;
  }

  .journey-large {
    grid-row: span 2;
  }

  .journey-image {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    transition: transform 0.6s ease;
  }

  .journey-card:hover .journey-image {
    transform: scale(1.05);
  }

  .journey-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        0deg,
        rgba(5, 15, 24, 0.82),
        rgba(5, 15, 24, 0.05) 70%
      );
  }

  .journey-info {
    position: absolute;
    z-index: 2;
    inset: auto 28px 28px;
    display: flex;
    gap: 20px;
    align-items: flex-end;
  }

  .journey-number {
    align-self: flex-start;
    font-size: 11px;
    letter-spacing: 2px;
    opacity: 0.75;
  }

  .journey-info p {
    margin: 0 0 6px;
    font-size: 9px;
    letter-spacing: 2px;
    font-weight: 700;
  }

  .journey-info h3 {
    margin: 0 0 7px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(34px, 4vw, 58px);
    line-height: 1;
    font-weight: 400;
  }

  .journey-card:not(.journey-large) .journey-info h3 {
    font-size: 38px;
  }

  .journey-arrow {
    font-size: 12px;
    font-weight: 600;
  }

  .korea-image {
    background:
      linear-gradient(
        135deg,
        #3b4d55,
        #172536
      );
  }


  /* =========================
     FEATURED STORY
  ========================= */

  .story-feature {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    min-height: 650px;
    background: #fff;
  }

  .story-image-wrap {
    overflow: hidden;
  }

  .story-image-wrap img {
    width: 100%;
    height: 100%;
    min-height: 600px;
    display: block;
    object-fit: cover;
  }

  .story-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 90px 9%;
  }

  .story-category {
    margin: 10px 0 18px;
    color: #8b4a3c;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .story-content h2 {
    margin: 0 0 25px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(44px, 5vw, 70px);
    line-height: 1;
    font-weight: 400;
    color: #172536;
    letter-spacing: -2px;
  }

  .story-content > p:not(.story-category) {
    max-width: 480px;
    margin: 0 0 30px;
    color: #59636c;
    font-size: 17px;
    line-height: 1.7;
  }

  .dark-button {
    width: fit-content;
    background: #172536;
    color: white;
  }


  /* =========================
     PHOTO STRIP
  ========================= */

  .photo-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    height: 300px;
  }

  .strip-photo {
    background-size: cover;
    background-position: center;
  }


  /* =========================
     EXPLORE
  ========================= */

  .explore {
    max-width: 1250px;
    margin: auto;
    padding: 120px 6%;
  }

  .explore-heading {
    max-width: 650px;
    margin-bottom: 55px;
  }

  .explore-heading h2 {
    margin: 0;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(44px, 5vw, 70px);
    line-height: 1;
    font-weight: 400;
    color: #172536;
    letter-spacing: -2px;
  }

  .explore-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid #dedbd4;
    border-bottom: 1px solid #dedbd4;
  }

  .explore-card {
    padding: 42px 30px 45px;
    color: #172536;
    text-decoration: none;
    border-right: 1px solid #dedbd4;
    transition: background 0.25s ease;
  }

  .explore-card:last-child {
    border-right: none;
  }

  .explore-card:hover {
    background: #f5f2eb;
  }

  .explore-icon {
    display: block;
    margin-bottom: 25px;
    color: #8b4a3c;
    font-size: 24px;
  }

  .explore-card h3 {
    margin: 0 0 12px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 32px;
    font-weight: 400;
  }

  .explore-card p {
    min-height: 75px;
    margin: 0 0 25px;
    color: #66717a;
    line-height: 1.65;
  }

  .explore-arrow {
    font-size: 13px;
    font-weight: 700;
  }


  /* =========================
     CLOSING
  ========================= */

  .closing {
    padding: 130px 6%;
    background: #172536;
    color: white;
    text-align: center;
  }

  .closing-inner {
    max-width: 800px;
    margin: auto;
  }

  .closing .eyebrow {
    color: #d6a08f;
  }

  .closing h2 {
    margin: 0 auto 35px;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(50px, 7vw, 90px);
    line-height: 0.95;
    font-weight: 400;
    letter-spacing: -3px;
  }

  .light-button {
    background: white;
    color: #172536;
  }


  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 850px) {

    .hero {
      min-height: 680px;
    }

    .hero-content {
      padding: 100px 7%;
    }

    .hero h1 {
      font-size: clamp(52px, 13vw, 75px);
    }

    .hero-description {
      font-size: 16px;
    }

    .hero-actions {
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
    }

    .hero-scroll {
      display: none;
    }

    .intro {
      grid-template-columns: 1fr;
      gap: 30px;
      padding: 80px 7%;
    }

    .intro-label {
      flex-direction: row;
    }

    .section-top {
      align-items: flex-start;
      flex-direction: column;
      gap: 20px;
    }

    .featured {
      padding: 80px 6%;
    }

    .journey-grid {
      display: flex;
      flex-direction: column;
    }

    .journey-card,
    .journey-large {
      min-height: 380px;
    }

    .story-feature {
      grid-template-columns: 1fr;
    }

    .story-image-wrap img {
      min-height: 420px;
      max-height: 500px;
    }

    .story-content {
      padding: 75px 7%;
    }

    .photo-strip {
      height: 180px;
    }

    .explore {
      padding: 80px 7%;
    }

    .explore-grid {
      grid-template-columns: 1fr;
    }

    .explore-card {
      border-right: none;
      border-bottom: 1px solid #dedbd4;
    }

    .explore-card:last-child {
      border-bottom: none;
    }

    .explore-card p {
      min-height: auto;
    }

    .closing {
      padding: 100px 7%;
    }

  }

</style>