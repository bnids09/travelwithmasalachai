---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="Blog | Travel With Masala Chai" description="Family travel notes, planning ideas and practical stories.">
  <section class="blog-page">
    <p class="eyebrow">THE BLOG</p>
    <h1>Travel notes, tips &amp; ideas.</h1>
    <p class="intro">Practical travel advice, planning ideas, experiences and stories from the road.</p>

    <section class="post-grid" aria-label="Blog posts">
      <article class="post-card">
        <p class="post-type">FAMILY TRAVEL</p>
        <h2>How to Plan a Family-Friendly Trip Without Overcomplicating It</h2>
        <p>A thoughtful, flexible approach to choosing destinations, planning days and travelling more comfortably with children.</p>
        <a href={`${base}blog/family-friendly-trip-planning/`}>Read article <span aria-hidden="true">→</span></a>
      </article>
    </section>
  </section>
</BaseLayout>

<style>
  .blog-page { max-width: 1100px; margin: auto; padding: 100px 5% 130px; }
  .eyebrow, .post-type { margin: 0; color: #8b4a3c; font-size: 12px; font-weight: 700; letter-spacing: 2.2px; }
  h1, h2 { color: #172536; font-family: Georgia, "Times New Roman", serif; }
  h1 { max-width: 850px; margin: 20px 0 24px; font-size: clamp(48px, 7vw, 84px); line-height: .97; letter-spacing: -1.5px; }
  .intro { max-width: 610px; margin: 0; color: #53606c; font-size: 19px; line-height: 1.7; }
  .post-grid { margin-top: 68px; }
  .post-card { max-width: 760px; padding: 42px; background: #fff; border: 1px solid #e4dfd5; box-shadow: 0 12px 32px rgba(23, 37, 54, .05); }
  .post-card h2 { max-width: 650px; margin: 18px 0 16px; font-size: clamp(32px, 4vw, 48px); line-height: 1.08; letter-spacing: -.7px; }
  .post-card > p:not(.post-type) { max-width: 590px; margin: 0 0 28px; color: #53606c; font-size: 17px; line-height: 1.65; }
  .post-card a { color: #172536; font-weight: 700; text-decoration-color: #c8a99d; text-underline-offset: 5px; }
  .post-card a:hover { color: #8b4a3c; }
  .post-card a span { margin-left: 6px; }
  @media (max-width: 600px) { .blog-page { padding-top: 72px; } .post-card { padding: 30px 25px; } }
</style>
