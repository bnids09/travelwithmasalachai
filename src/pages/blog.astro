---
const title = "Blog | @travelwithMasalaChai";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>

  <body>
    <header>
      <a href="/">Travel With Masala Chai</a>

      <nav>
        <a href="/">Home</a>
        <a href="/journal">Journal</a>
        <a href="/blog">Blog</a>
        <a href="/about">About</a>
      </nav>
    </header>

    <main>
      <p class="eyebrow">THE BLOG</p>

      <h1>Travel notes, tips & ideas.</h1>

      <p class="intro">
        Practical travel advice, planning ideas, experiences and stories from
        the road.
      </p>

      <section>
        <article>
          <p>TRAVEL TIPS</p>
          <h2>How to plan a trip without overcomplicating it</h2>
          <a href="#">Read article →</a>
        </article>

        <article>
          <p>DESTINATIONS</p>
          <h2>Things worth knowing before visiting Oman</h2>
          <a href="#">Read article →</a>
        </article>

        <article>
          <p>PLANNING</p>
          <h2>How we plan family trips</h2>
          <a href="#">Read article →</a>
        </article>
      </section>
    </main>

    <footer>
      <p>© 2026 Travel With Masala Chai</p>
    </footer>
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    font-family: Arial, sans-serif;
    color: #171717;
    background: #f7f5f1;
  }

  header {
    padding: 28px 5%;
    background: white;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  header > a {
    font-size: 24px;
    font-weight: 700;
    color: inherit;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 32px;
  }

  nav a {
    color: inherit;
    text-decoration: none;
  }

  main {
    max-width: 1100px;
    margin: auto;
    padding: 100px 5%;
  }

  .eyebrow {
    letter-spacing: 3px;
    font-weight: 700;
    font-size: 14px;
  }

  h1 {
    font-size: clamp(48px, 7vw, 90px);
    line-height: 0.95;
    margin: 25px 0;
  }

  .intro {
    max-width: 650px;
    font-size: 20px;
    line-height: 1.6;
    color: #555;
  }

  section {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
    margin-top: 80px;
  }

  article {
    background: white;
    padding: 35px;
    min-height: 220px;
  }

  article p {
    font-size: 13px;
    letter-spacing: 2px;
    font-weight: 700;
  }

  article h2 {
    font-size: 30px;
    line-height: 1.2;
  }

  article a {
    color: inherit;
    font-weight: 700;
  }

  footer {
    padding: 40px 5%;
    background: #171717;
    color: white;
  }

  @media (max-width: 700px) {
    header {
      flex-direction: column;
      gap: 20px;
      align-items: flex-start;
    }

    section {
      grid-template-columns: 1fr;
    }
  }
</style>