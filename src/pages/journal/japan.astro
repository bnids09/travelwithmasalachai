---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = `${import.meta.env.BASE_URL}/`;
const coverImage = `${base}images/japan/cover.jpg`;
---

<BaseLayout
  title="Japan Travel Journal | Travel With Masala Chai"
  description="Our Japan travel journal covering Tokyo, Mt. Fuji and Hokkaido."
>

  <!-- HERO -->

  <section class="japan-hero">
  <div
  class="hero-image"
  style={`background-image: url('${coverImage}')`}
></div>

    <div class="hero-overlay"></div>

    <div class="hero-content">

      <p class="eyebrow">
        TRAVEL JOURNAL · JAPAN
      </p>

      <h1>
        Our Japan Journey
      </h1>

      <p class="route">
        Tokyo → Mt. Fuji → Hokkaido
      </p>

    </div>

  </section>


  <!-- INTRO -->

  <section class="intro-section">

    <div class="section-label">
      <span>THE JOURNEY</span>
    </div>

    <div class="intro-text">

      <p class="lead">
        Japan was a journey through busy cities, quiet landscapes,
        mountains, beautiful seasons and experiences we will remember
        for a long time.
      </p>

      <p>
        This is our personal account of the trip, including the places
        we visited, the things we experienced and the practical details
        that can help you plan your own Japan journey.
      </p>

      <a class="itinerary-card" href={`${base}journal/japan/itinerary/`}>
  <span class="itinerary-card-label">PLAN YOUR JOURNEY</span>

  <span class="itinerary-card-title">
    Japan Itinerary
  </span>

  <span class="itinerary-card-route">
    Tokyo → Mt. Fuji → Hokkaido
  </span>

  <span class="itinerary-card-action">
    Read our 11-day itinerary →
  </span>
</a>

    </div>

  </section>


  <!-- TOKYO -->

  <section class="destination-section">

    <div class="destination-heading">

      <p class="eyebrow dark">
        01 · TOKYO
      </p>

      <h2>
        Tokyo
      </h2>

    </div>

    <div class="destination-layout">

      <div class="destination-photo">
        <img src={`${base}images/japan/shibuya-crossing.jpg`} alt="View over Shibuya Crossing in Tokyo" loading="lazy" />
      </div>

      <div class="story">

        <p class="lead-small">
          The beginning of our Japan journey.
        </p>

        <p>
          This section will become the story of our time in Tokyo.
          We'll add your actual experiences here rather than using
          generic travel-guide content.
        </p>

        <p>
          Places visited, food, neighbourhoods, memorable moments,
          transport and anything that surprised us will go here.
        </p>

      </div>

    </div>

  </section>


  <!-- MT FUJI -->

  <section class="destination-section alternate">

    <div class="destination-heading">

      <p class="eyebrow dark">
        02 · MT. FUJI
      </p>

      <h2>
        Mt. Fuji
      </h2>

    </div>

    <div class="destination-layout">

      <div class="destination-photo">
        <img src={`${base}images/japan/lake-kawaguchiko-mount-fuji.jpg`} alt="Mount Fuji viewed from Lake Kawaguchiko" loading="lazy" />
      </div>

      <div class="story">

        <p class="lead-small">
          Mountains, views and a very different side of Japan.
        </p>

        <p>
          Here we'll tell the story of your Mt. Fuji experience,
          including where you stayed, how you got there and what
          you actually saw and did.
        </p>

      </div>

    </div>

  </section>


  <!-- SAPPORO -->

  <section class="destination-section">

    <div class="destination-heading">

      <p class="eyebrow dark">
        03 · HOKKAIDO
      </p>

      <h2>
        Hokkaido
      </h2>

    </div>

    <div class="destination-layout">

      <div class="photo-placeholder">
        <span>Your Sapporo photo</span>
      </div>

      <div class="story">

        <p class="lead-small">
          A different rhythm, a different landscape.
        </p>

        <p>
          Your Sapporo experience will go here, with your photographs,
          places visited and the moments that made this part of the
          trip special.
        </p>

      </div>

    </div>

  </section>


  <!-- TRIP DETAILS -->

  <section class="details-section">

    <div class="section-label">
      <span>TRIP DETAILS</span>
    </div>

    <div class="details-grid">

      <div>
        <span>WHEN</span>
        <strong>Japan trip</strong>
        <p>Dates to be added</p>
      </div>

      <div>
        <span>ROUTE</span>
        <strong>Tokyo · Fuji · Sapporo</strong>
        <p>Our route</p>
      </div>

      <div>
        <span>TRANSPORT</span>
        <strong>To be added</strong>
        <p>Flights, trains & local transport</p>
      </div>

      <div>
        <span>STAYS</span>
        <strong>To be added</strong>
        <p>Hotels and accommodation</p>
      </div>

    </div>

  </section>


  <!-- PHOTO GALLERY -->

  <section class="gallery-section">

    <div class="gallery-heading">

      <div>
        <p class="eyebrow dark">
          PHOTO JOURNAL
        </p>

        <h2>
          Moments from Japan
        </h2>
      </div>

    </div>

    <div class="gallery-grid">
      <img class="wide" src={`${base}images/japan/teamlab-family.jpg`} alt="Family moment at teamLab in Tokyo" loading="lazy" />
      <img src={`${base}images/japan/tokyo-autumn-leaf.jpg`} alt="Autumn leaf held on a Tokyo street" loading="lazy" />
      <img src={`${base}images/japan/mt-fuji-bicycles.jpg`} alt="Mount Fuji above bicycles and a station car park" loading="lazy" />
      <img src={`${base}images/japan/mt-fuji-forest-road.jpg`} alt="Forest road near Mount Fuji" loading="lazy" />
      <img src={`${base}images/japan/mt-fuji-ice-cream.jpg`} alt="Ice cream with Mount Fuji in the background" loading="lazy" />
      <img src={`${base}images/japan/oshino-hakkai-mount-fuji.jpg`} alt="Oshino Hakkai with Mount Fuji beyond the ponds" loading="lazy" />
      <img src={`${base}images/japan/fuji-safari-park.jpg`} alt="Mount Fuji behind Fuji Safari Park" loading="lazy" />
      <img src={`${base}images/japan/fuji-safari-wallaby.jpg`} alt="Child meeting a wallaby at Fuji Safari Park" loading="lazy" />
      <img src={`${base}images/japan/fujiq-highland-view.jpg`} alt="View towards Fuji-Q Highland" loading="lazy" />
      <img src={`${base}images/japan/lake-kawaguchiko-path.jpg`} alt="Path through pink grass near Lake Kawaguchiko" loading="lazy" />
      <img src={`${base}images/japan/usagi-shrine-wishes.jpg`} alt="Wooden wish plaques at Usagi Shrine" loading="lazy" />
      <img src={`${base}images/japan/otsuki-map.jpg`} alt="Child looking at a sightseeing map in Otsuki" loading="lazy" />
      <img src={`${base}images/japan/mt-fuji-rental-car.jpg`} alt="Small rental car near Mount Fuji" loading="lazy" />
    </div>

  </section>


  <!-- TIPS -->

  <section class="tips-section">

    <p class="eyebrow dark">
      FROM OUR EXPERIENCE
    </p>

    <h2>
      Things worth knowing
    </h2>

    <p class="tips-intro">
      Practical tips from the trip will go here.
      What worked, what didn't, what surprised us and
      what we would do differently next time.
    </p>

  </section>

</BaseLayout>


<style>

  /* HERO */

  .japan-hero {
    position: relative;
    min-height: 650px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .hero-image {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

  .hero-overlay {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        90deg,
        rgba(10, 20, 30, 0.72),
        rgba(10, 20, 30, 0.15)
      );
  }

  .hero-content {
    position: relative;
    z-index: 2;

    width: 100%;
    max-width: 1180px;

    margin: auto;

    padding:
      100px 6%;

    color: white;
  }

  .eyebrow {
    margin: 0;

    font-size: 13px;
    font-weight: 700;
    letter-spacing: 3px;
  }

  .eyebrow.dark {
    color: #8b4a3c;
  }

  .hero-content h1 {
    max-width: 850px;

    margin:
      22px 0
      15px;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(
        58px,
        8vw,
        105px
      );

    line-height: 0.95;

    letter-spacing: -2px;
  }

  .route {
    margin: 0;

    font-size: 20px;
    letter-spacing: 1px;
  }


  /* INTRO */

  .intro-section {

    max-width: 1050px;

    margin: auto;

    padding:
      100px 6%
      110px;

    display: grid;

    grid-template-columns:
      180px
      1fr;

    gap: 60px;

  }

  .section-label {
    padding-top: 8px;
  }

  .section-label span {

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 2.5px;

    color: #7a7f82;

  }

  .intro-text {

    max-width: 720px;

    color: #53606c;

    font-size: 19px;

    line-height: 1.8;

  }

  .itinerary-link {
    display: inline-block;
    margin-top: 24px;
    color: #8b4a3c;
    font-weight: 700;
    text-decoration-color: #c8a99d;
    text-underline-offset: 5px;
  }
  .itinerary-card {
  display: block;
  max-width: 620px;
  margin-top: 35px;
  padding: 28px 30px;
  border: 1px solid #ddd9d1;
  background: #f1eee7;
  color: #172536;
  text-decoration: none;
  transition:
    background 0.25s ease,
    transform 0.25s ease,
    border-color 0.25s ease;
}

.itinerary-card-label {
  display: block;
  margin-bottom: 12px;
  color: #8b4a3c;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 2px;
}

.itinerary-card-title {
  display: block;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 32px;
  line-height: 1.2;
}

.itinerary-card-route {
  display: block;
  margin-top: 10px;
  color: #53606c;
  font-size: 16px;
}

.itinerary-card-action {
  display: block;
  margin-top: 22px;
  color: #8b4a3c;
  font-weight: 700;
  text-decoration: underline;
  text-underline-offset: 5px;
}

.itinerary-card:hover {
  background: #e9e4da;
  border-color: #c8a99d;
  transform: translateY(-3px);
}

  .intro-text p {
    margin: 0 0 28px;
  }

  .intro-text .lead {

    color: #24384b;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 27px;

    line-height: 1.5;

  }


  /* DESTINATIONS */

  .destination-section {

    max-width: 1180px;

    margin: auto;

    padding:
      80px 6%
      120px;

  }

  .destination-section.alternate {
    background: #f1eee7;
    max-width: none;

    padding-left: max(6%, calc((100% - 1060px) / 2));
    padding-right: max(6%, calc((100% - 1060px) / 2));
  }

  .destination-heading {
    margin-bottom: 45px;
  }

  .destination-heading h2 {

    margin: 10px 0 0;

    color: #172536;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(
        48px,
        6vw,
        72px
      );

    line-height: 1;

  }

  .destination-layout {

    display: grid;

    grid-template-columns:
      1.35fr
      1fr;

    gap: 70px;

    align-items: center;

  }

  .photo-placeholder {

    min-height: 450px;

    background:
      #ddd8ce;

    display: flex;

    align-items: center;

    justify-content: center;

    color: #777;

    font-size: 14px;

    letter-spacing: 1px;

  }

  .story {

    max-width: 500px;

    color: #53606c;

    font-size: 17px;

    line-height: 1.75;

  }

  .story p {
    margin: 0 0 25px;
  }

  .story .lead-small {

    color: #172536;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 27px;

    line-height: 1.4;

  }


  /* DETAILS */

  .details-section {

    max-width: 1180px;

    margin: auto;

    padding:
      100px 6%
      110px;

  }

  .details-grid {

    display: grid;

    grid-template-columns:
      repeat(4, 1fr);

    gap: 25px;

    margin-top: 45px;

    border-top:
      1px solid #ddd9d1;

  }

  .details-grid > div {

    padding:
      30px 10px;

    border-bottom:
      1px solid #ddd9d1;

  }

  .details-grid span {

    display: block;

    margin-bottom: 12px;

    color: #8b4a3c;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 2px;

  }

  .details-grid strong {

    display: block;

    color: #172536;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 21px;

  }

  .details-grid p {

    margin:
      8px 0 0;

    color: #777;

    font-size: 14px;

  }


  /* GALLERY */

  .gallery-section {

    background: #f1eee7;

    padding:
      100px 6%
      120px;

  }

  .gallery-heading {

    max-width: 1180px;

    margin: auto;

  }

  .gallery-heading h2 {

    margin:
      10px 0 45px;

    color: #172536;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(
        42px,
        5vw,
        64px
      );

  }

  .gallery-placeholder {

    max-width: 1180px;

    min-height: 300px;

    margin: auto;

    display: flex;

    align-items: center;

    justify-content: center;

    border:
      1px dashed #c7c1b7;

    color: #777;

  }


  .destination-photo {
    min-height: 360px;
    overflow: hidden;
  }

  .destination-photo img {
    width: 100%;
    min-height: 360px;
    height: 100%;
    object-fit: cover;
  }

  .gallery-grid {
    max-width: 1180px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .gallery-grid img {
    width: 100%;
    height: 280px;
    object-fit: cover;
  }

  .gallery-grid .wide {
    grid-column: span 2;
  }

  /* TIPS */

  .tips-section {

    max-width: 850px;

    margin: auto;

    padding:
      110px 6%
      140px;

  }

  .tips-section h2 {

    margin:
      15px 0
      25px;

    color: #172536;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(
        42px,
        5vw,
        64px
      );

  }

  .tips-intro {

    max-width: 650px;

    color: #53606c;

    font-size: 19px;

    line-height: 1.8;

  }


  /* MOBILE */

  @media (max-width: 800px) {

    .japan-hero {
      min-height: 550px;
    }

    .intro-section {
      grid-template-columns: 1fr;
      gap: 25px;
    }

    .destination-layout {
      grid-template-columns: 1fr;
      gap: 35px;
    }

    .photo-placeholder {
      min-height: 300px;
    }

    .destination-photo,
    .destination-photo img {
      min-height: 300px;
    }

    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .details-grid {
      grid-template-columns:
        repeat(2, 1fr);
    }

  }

  @media (max-width: 550px) {

    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .gallery-grid .wide {
      grid-column: auto;
    }

    .details-grid {
      grid-template-columns: 1fr;
    }

  }

</style>
