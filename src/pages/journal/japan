---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Japan Travel Journal | Travel With Masala Chai"
  description="Our Japan travel journal covering Tokyo, Mt. Fuji and Sapporo."
>

  <!-- HERO -->

  <section class="japan-hero">

    <div class="hero-image"></div>

    <div class="hero-overlay"></div>

    <div class="hero-content">

      <p class="eyebrow">
        TRAVEL JOURNAL · JAPAN
      </p>

      <h1>
        Our Japan Journey
      </h1>

      <p class="route">
        Tokyo → Mt. Fuji → Sapporo
      </p>

    </div>

  </section>


  <!-- INTRO -->

  <section class="intro-section">

    <div class="section-label">
      <span>THE JOURNEY</span>
    </div>

    <div class="intro-text">

      <p class="lead">
        Japan was a journey through busy cities, quiet landscapes,
        mountains, beautiful seasons and experiences we will remember
        for a long time.
      </p>

      <p>
        This is our personal account of the trip, including the places
        we visited, the things we experienced and the practical details
        that can help you plan your own Japan journey.
      </p>

    </div>

  </section>


  <!-- TOKYO -->

  <section class="destination-section">

    <div class="destination-heading">

      <p class="eyebrow dark">
        01 · TOKYO
      </p>

      <h2>
        Tokyo
      </h2>

    </div>

    <div class="destination-layout">

      <div class="photo-placeholder">
        <span>Your Tokyo photo</span>
      </div>

      <div class="story">

        <p class="lead-small">
          The beginning of our Japan journey.
        </p>

        <p>
          This section will become the story of our time in Tokyo.
          We'll add your actual experiences here rather than using
          generic travel-guide content.
        </p>

        <p>
          Places visited, food, neighbourhoods, memorable moments,
          transport and anything that surprised us will go here.
        </p>

      </div>

    </div>

  </section>


  <!-- MT FUJI -->

  <section class="destination-section alternate">

    <div class="destination-heading">

      <p class="eyebrow dark">
        02 · MT. FUJI
      </p>

      <h2>
        Mt. Fuji
      </h2>

    </div>

    <div class="destination-layout">

      <div class="photo-placeholder">
        <span>Your Mt. Fuji photo</span>
      </div>

      <div class="story">

        <p class="lead-small">
          Mountains, views and a very different side of Japan.
        </p>

        <p>
          Here we'll tell the story of your Mt. Fuji experience,
          including where you stayed, how you got there and what
          you actually saw and did.
        </p>

      </div>

    </div>

  </section>


  <!-- SAPPORO -->

  <section class="destination-section">

    <div class="destination-heading">

      <p class="eyebrow dark">
        03 · SAPPORO
      </p>

      <h2>
        Sapporo
      </h2>

    </div>

    <div class="destination-layout">

      <div class="photo-placeholder">
        <span>Your Sapporo photo</span>
      </div>

      <div class="story">

        <p class="lead-small">
          A different rhythm, a different landscape.
        </p>

        <p>
          Your Sapporo experience will go here, with your photographs,
          places visited and the moments that made this part of the
          trip special.
        </p>

      </div>

    </div>

  </section>


  <!-- TRIP DETAILS -->

  <section class="details-section">

    <div class="section-label">
      <span>TRIP DETAILS</span>
    </div>

    <div class="details-grid">

      <div>
        <span>WHEN</span>
        <strong>Japan trip</strong>
        <p>Dates to be added</p>
      </div>

      <div>
        <span>ROUTE</span>
        <strong>Tokyo · Fuji · Sapporo</strong>
        <p>Our route</p>
      </div>

      <div>
        <span>TRANSPORT</span>
        <strong>To be added</strong>
        <p>Flights, trains & local transport</p>
      </div>

      <div>
        <span>STAYS</span>
        <strong>To be added</strong>
        <p>Hotels and accommodation</p>
      </div>

    </div>

  </section>


  <!-- PHOTO GALLERY -->

  <section class="gallery-section">

    <div class="gallery-heading">

      <div>
        <p class="eyebrow dark">
          PHOTO JOURNAL
        </p>

        <h2>
          Moments from Japan
        </h2>
      </div>

    </div>

    <div class="gallery-placeholder">

      <p>
        Your Japan photographs will appear here.
      </p>

    </div>

  </section>


  <!-- TIPS -->

  <section class="tips-section">

    <p class="eyebrow dark">
      FROM OUR EXPERIENCE
    </p>

    <h2>
      Things worth knowing
    </h2>

    <p class="tips-intro">
      Practical tips from the trip will go here.
      What worked, what didn't, what surprised us and
      what we would do differently next time.
    </p>

  </section>

</BaseLayout>


<style>

  /* HERO */

  .japan-hero {
    position: relative;
    min-height: 650px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  .hero-image {
    position: absolute;
    inset: 0;

    background-image:
      url("/images/japan/cover.jpg");

    background-size: cover;
    background-position: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        90deg,
        rgba(10, 20, 30, 0.72),
        rgba(10, 20, 30, 0.15)
      );
  }

  .hero-content {
    position: relative;
    z-index: 2;

    width: 100%;
    max-width: 1180px;

    margin: auto;

    padding:
      100px 6%;

    color: white;
  }

  .eyebrow {
    margin: 0;

    font-size: 13px;
    font-weight: 700;
    letter-spacing: 3px;
  }

  .eyebrow.dark {
    color: #8b4a3c;
  }

  .hero-content h1 {
    max-width: 850px;

    margin:
      22px 0
      15px;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(
        58px,
        8vw,
        105px
      );

    line-height: 0.95;

    letter-spacing: -2px;
  }

  .route {
    margin: 0;

    font-size: 20px;
    letter-spacing: 1px;
  }


  /* INTRO */

  .intro-section {

    max-width: 1050px;

    margin: auto;

    padding:
      100px 6%
      110px;

    display: grid;

    grid-template-columns:
      180px
      1fr;

    gap: 60px;

  }

  .section-label {
    padding-top: 8px;
  }

  .section-label span {

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 2.5px;

    color: #7a7f82;

  }

  .intro-text {

    max-width: 720px;

    color: #53606c;

    font-size: 19px;

    line-height: 1.8;

  }

  .intro-text p {
    margin: 0 0 28px;
  }

  .intro-text .lead {

    color: #24384b;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 27px;

    line-height: 1.5;

  }


  /* DESTINATIONS */

  .destination-section {

    max-width: 1180px;

    margin: auto;

    padding:
      80px 6%
      120px;

  }

  .destination-section.alternate {
    background: #f1eee7;
    max-width: none;

    padding-left: max(6%, calc((100% - 1060px) / 2));
    padding-right: max(6%, calc((100% - 1060px) / 2));
  }

  .destination-heading {
    margin-bottom: 45px;
  }

  .destination-heading h2 {

    margin: 10px 0 0;

    color: #172536;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(
        48px,
        6vw,
        72px
      );

    line-height: 1;

  }

  .destination-layout {

    display: grid;

    grid-template-columns:
      1.35fr
      1fr;

    gap: 70px;

    align-items: center;

  }

  .photo-placeholder {

    min-height: 450px;

    background:
      #ddd8ce;

    display: flex;

    align-items: center;

    justify-content: center;

    color: #777;

    font-size: 14px;

    letter-spacing: 1px;

  }

  .story {

    max-width: 500px;

    color: #53606c;

    font-size: 17px;

    line-height: 1.75;

  }

  .story p {
    margin: 0 0 25px;
  }

  .story .lead-small {

    color: #172536;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 27px;

    line-height: 1.4;

  }


  /* DETAILS */

  .details-section {

    max-width: 1180px;

    margin: auto;

    padding:
      100px 6%
      110px;

  }

  .details-grid {

    display: grid;

    grid-template-columns:
      repeat(4, 1fr);

    gap: 25px;

    margin-top: 45px;

    border-top:
      1px solid #ddd9d1;

  }

  .details-grid > div {

    padding:
      30px 10px;

    border-bottom:
      1px solid #ddd9d1;

  }

  .details-grid span {

    display: block;

    margin-bottom: 12px;

    color: #8b4a3c;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 2px;

  }

  .details-grid strong {

    display: block;

    color: #172536;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size: 21px;

  }

  .details-grid p {

    margin:
      8px 0 0;

    color: #777;

    font-size: 14px;

  }


  /* GALLERY */

  .gallery-section {

    background: #f1eee7;

    padding:
      100px 6%
      120px;

  }

  .gallery-heading {

    max-width: 1180px;

    margin: auto;

  }

  .gallery-heading h2 {

    margin:
      10px 0 45px;

    color: #172536;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(
        42px,
        5vw,
        64px
      );

  }

  .gallery-placeholder {

    max-width: 1180px;

    min-height: 300px;

    margin: auto;

    display: flex;

    align-items: center;

    justify-content: center;

    border:
      1px dashed #c7c1b7;

    color: #777;

  }


  /* TIPS */

  .tips-section {

    max-width: 850px;

    margin: auto;

    padding:
      110px 6%
      140px;

  }

  .tips-section h2 {

    margin:
      15px 0
      25px;

    color: #172536;

    font-family:
      Georgia,
      "Times New Roman",
      serif;

    font-size:
      clamp(
        42px,
        5vw,
        64px
      );

  }

  .tips-intro {

    max-width: 650px;

    color: #53606c;

    font-size: 19px;

    line-height: 1.8;

  }


  /* MOBILE */

  @media (max-width: 800px) {

    .japan-hero {
      min-height: 550px;
    }

    .intro-section {
      grid-template-columns: 1fr;
      gap: 25px;
    }

    .destination-layout {
      grid-template-columns: 1fr;
      gap: 35px;
    }

    .photo-placeholder {
      min-height: 300px;
    }

    .details-grid {
      grid-template-columns:
        repeat(2, 1fr);
    }

  }

  @media (max-width: 550px) {

    .details-grid {
      grid-template-columns: 1fr;
    }

  }

</style>